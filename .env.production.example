# ============================================================
# zzmm-search production env (zzmm-search.uk on Z4 Pro)
# 复制到 .env.production 后填真实值, .env.production 不进 git
# ============================================================

# ---- Neon Postgres (远程, 24 万资源) ----
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-misty-resonance-aoiefatw.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ---- JWT (从 Vercel 当前值拷, 不重置!) ----
JWT_SECRET=YOUR_VERCEL_JWT_SECRET
JWT_EXPIRES_IN=7d

# ---- Redis (NAS 本机, 走 host.docker.internal) ----
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- TMDB ----
TMDB_API_KEY=YOUR_TMDB_API_KEY

# ---- 站点 ----
SITE_NAME=泽泽妈妈资源库
SITE_URL=https://zzmm-search.uk
ADMIN_EMAIL=admin@zzmm-search.uk
WECHAT_CONTACT=HKmaipanren
