{
  "framework": "nextjs",
  "buildCommand": "NEXT_TELEMETRY_DISABLED=1 npx next build",
  "installCommand": "npm install",
  "github": {
    "autoJobCancelInProgress": true
  },
  "crons": [
    {
      "path": "/api/cron/match-task",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/tg-l3-worker",
      "schedule": "0 3 * * *"
    }
  ]
}